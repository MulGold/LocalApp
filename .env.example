# ==============================================================================
# Environment Configuration & Secrets Template
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

# ------------------------------------------------------------------------------
# Database Configuration (MongoDB Atlas)
# ------------------------------------------------------------------------------
# MongoDB connection URI (e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/ecommerce_db?retryWrites=true&w=majority)
# If left blank or unreachable, the application automatically uses high-performance in-memory fallback storage.
MONGODB_URI=

# ------------------------------------------------------------------------------
# Brevo HTTPS Transactional Email API (Verification Codes)
# ------------------------------------------------------------------------------
# Brevo API Key (e.g., xkeysib-...)
BREVO_API_KEY=
# Verified Sender Email in your Brevo account (e.g., info@yourdomain.com)
BREVO_SENDER_EMAIL=
# Sender Name (defaults to Gips Kitchen)
BREVO_SENDER_NAME=Gips Kitchen

# ------------------------------------------------------------------------------
# Session Authentication Configuration
# ------------------------------------------------------------------------------
# Secret key for stateless HMAC-SHA256 session token generation and verification
SESSION_SECRET=

# ------------------------------------------------------------------------------
# Default Store Administrator Account
# ------------------------------------------------------------------------------
# Default admin credentials seeded automatically on startup.
# Note: Password must be 8 characters long, containing at least 1 uppercase letter and 1 number.
ADMIN_EMAIL=admin@store.com
ADMIN_PASSWORD=Admin123

# ------------------------------------------------------------------------------
# Local Test Admin Bootstrap (For JMeter / Local Development Only)
# ------------------------------------------------------------------------------
# Set to 'true' and set NODE_ENV=development to allow bootstrap-local-admin execution
BOOTSTRAP_LOCAL_ADMIN=false
# Dedicated password for localadmin@gipskitchen.test (min 8 chars, 1 uppercase, 1 number)
LOCAL_ADMIN_PASSWORD=
# Optional explicit test database name verification (e.g., ecommerce_test)
TEST_DB_NAME=
